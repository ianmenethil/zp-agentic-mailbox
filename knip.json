{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "workers/index.ts",
    "workers/**/*.test.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx,css}",
    "workers/**/*.{ts,tsx}",
    "shared/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "cloudflare"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "catalog": "warn"
  }
}
