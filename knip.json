{
  "$schema": "https://unpkg.com/knip@5/overview/configuration-schema.json",
  "entry": [
    "workers/index.ts",
    "workers/**/*.test.ts"
  ],
  "project": [
    "app/**/*.{ts,tsx,css}",
    "workers/**/*.{ts,tsx}",
    "shared/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "cloudflare"
  ],
  "ignoreExportsUsedInFile": true,
  "includeEntryExports": true,
  "rules": {
    "files": "error",
    "dependencies": "error",
    "devDependencies": "error",
    "unlisted": "error",
    "binaries": "error",
    "unresolved": "error",
    "exports": "warn",
    "nsExports": "error",
    "types": "warn",
    "nsTypes": "error",
    "enumMembers": "error",
    "duplicates": "error",
    "cycles": "error",
    "catalog": "warn"
  }
}
