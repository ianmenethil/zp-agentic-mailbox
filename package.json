{
	"name": "agentic-inbox",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"cloudflare": {
		"label": "Agentic Inbox",
		"products": [
			"Workers",
			"Durable Objects",
			"R2",
			"Workers AI"
		],
		"bindings": {
			"DOMAINS": {
				"description": "Your domain with [Email Routing](https://developers.cloudflare.com/email-routing/) enabled (e.g. `example.com`). After deploying, create a catch-all Email Routing rule pointing to this Worker."
			}
		}
	},
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "pnpm run build && vite preview",
		"typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b",
		"test:rpc-policy": "tsx --test workers/lib/rpc-send-policy.test.ts",
		"test:email-mailer": "tsx --test workers/entrypoints/email-mailer.entrypoint.test.ts",
		"test:rpc": "tsx --test workers/lib/rpc-send-policy.test.ts workers/entrypoints/email-mailer.entrypoint.test.ts"
	},
	"dependencies": {
		"@ai-sdk/react": "^3.0.0",
		"@cloudflare/ai-chat": "^0.10.2",
		"@cloudflare/kumo": "^1.19.0",
		"@ianmenethil/zp-emails": "https://cdn.zenithpayments.support/zp-shared/emails-0.1.1.tgz",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.102.6",
		"@tiptap/extension-color": "3.20.2",
		"@tiptap/extension-highlight": "3.20.2",
		"@tiptap/extension-image": "3.20.2",
		"@tiptap/extension-link": "3.20.2",
		"@tiptap/extension-text-align": "3.20.2",
		"@tiptap/extension-text-style": "3.20.2",
		"@tiptap/extension-underline": "3.20.2",
		"@tiptap/react": "3.20.2",
		"@tiptap/starter-kit": "3.20.2",
		"agents": "^0.21.0",
		"ai": "^7.0.83",
		"dompurify": "^3.4.14",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.5",
		"isbot": "^5.2.1",
		"jose": "^6.2.10",
		"postal-mime": "^2.7.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"react-router": "^7.18.2",
		"remark-gfm": "^4.0.1",
		"workers-ai-provider": "^4.0.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.15"
	},
		"packageManager": "pnpm@11.24.0",
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.0",
		"@cloudflare/workers-types": "^5.20260827.1",
		"@react-router/dev": "^7.18.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/dompurify": "^3.2.0",
		"@types/node": "^20.19.43",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.20.5",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vite-tsconfig-paths": "^5.1.4",
		"wrangler": "^4.126.0"
	}
}
