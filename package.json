{
	"name": "agentic-inbox",
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"cloudflare": {
		"label": "Agentic Inbox",
		"products": [
			"Workers",
			"Durable Objects",
			"R2",
			"Workers AI"
		],
		"bindings": {
			"DOMAINS": {
				"description": "Your domain with [Email Routing](https://developers.cloudflare.com/email-routing/) enabled (e.g. `example.com`). After deploying, create a catch-all Email Routing rule pointing to this Worker."
			}
		}
	},
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "pnpm run build && vite preview",
		"typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"knip": "knip",
		"jscpd": "jscpd .",
		"test:rpc-policy": "tsx --test workers/lib/rpc-send-policy.test.ts",
		"test:email-mailer": "tsx --test workers/entrypoints/email-mailer.entrypoint.test.ts",
		"test:rpc": "tsx --test workers/lib/rpc-send-policy.test.ts workers/lib/rpc-sent-mailbox.test.ts workers/entrypoints/email-mailer.entrypoint.test.ts",
		"prepare": "lefthook install",
		"check": "pnpm install --frozen-lockfile && pnpm run test:rpc && pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run jscpd && pnpm run build"
	},
	"dependencies": {
		"@ai-sdk/react": "^4.0.86",
		"@base-ui/react": "^1.7.0",
		"@cloudflare/ai-chat": "^0.10.2",
		"@cloudflare/kumo": "^2.12.0",
		"@fontsource-variable/nunito-sans": "^5.3.0",
		"@fontsource-variable/outfit": "^5.3.0",
		"@modelcontextprotocol/sdk": "1.30.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.102.6",
		"@tiptap/extension-color": "3.20.2",
		"@tiptap/extension-highlight": "3.20.2",
		"@tiptap/extension-image": "3.20.2",
		"@tiptap/extension-link": "3.20.2",
		"@tiptap/extension-text-align": "3.20.2",
		"@tiptap/extension-text-style": "3.20.2",
		"@tiptap/extension-underline": "3.20.2",
		"@tiptap/react": "3.20.2",
		"@tiptap/starter-kit": "3.20.2",
		"@zp-shared/emails": "https://cdn.zenithpayments.support/zp-shared/emails-0.1.3.tgz",
		"agents": "^0.21.0",
		"ai": "^7.0.83",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dompurify": "^3.4.14",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.5",
		"isbot": "^5.2.1",
		"jose": "^6.2.10",
		"lucide-react": "^1.34.0",
		"postal-mime": "^3.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-markdown": "^10.1.0",
		"react-router": "^8.3.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"workers-ai-provider": "^4.0.0",
		"zod": "catalog:",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.54.0",
		"@cloudflare/workers-types": "^5.20260827.1",
		"@eslint/js": "^10.0.1",
		"@react-router/dev": "^8.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"eslint": "^10.9.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.11.0",
		"jscpd": "^5.0.16",
		"knip": "^6.32.3",
		"lefthook": "^2.0.0",
		"shadcn": "^4.19.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.20.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"wrangler": "^4.126.0"
	}
}
