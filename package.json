{
	"name": "agentic-inbox",
	"version": "0.0.0",
	"description": "Self-hosted AI email client on Cloudflare Workers: a Durable Object mailbox per address, an AI agent and an MCP server, used by Zenith's Workers.",
	"keywords": [
		"email",
		"cloudflare-workers",
		"durable-objects",
		"ai-agent",
		"mcp"
	],
	"private": true,
	"license": "Apache-2.0",
	"type": "module",
	"author": {
		"name": "Ian Menethil",
		"email": "ian@zenithpayments.com.au"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ianmenethil/zp-agentic-mailbox.git"
	},
	"packageManager": "pnpm@12.11.2",
	"engines": {
		"node": ">=22"
	},
	"cloudflare": {
		"label": "Agentic Inbox",
		"products": [
			"Workers",
			"Durable Objects",
			"R2",
			"Workers AI"
		],
		"bindings": {
			"DOMAINS": {
				"description": "Your domain with [Email Routing](https://developers.cloudflare.com/email-routing/) enabled (e.g. `example.com`). After deploying, create a catch-all Email Routing rule pointing to this Worker."
			}
		}
	},
	"scripts": {
		"build": "react-router build",
		"cf-typegen": "wrangler types --strict-vars=false",
		"deploy": "pnpm run build && wrangler deploy",
		"dev": "react-router dev",
		"preview": "pnpm run build && vite preview",
		"typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"knip": "knip",
		"jscpd": "jscpd .",
		"test:rpc-policy": "tsx --test workers/lib/rpc-send-policy.test.ts",
		"test:email-mailer": "tsx --test workers/entrypoints/email-mailer.entrypoint.test.ts",
		"test:rpc": "tsx --test workers/lib/rpc-send-policy.test.ts workers/lib/rpc-sent-mailbox.test.ts workers/entrypoints/email-mailer.entrypoint.test.ts",
		"prepare": "lefthook install",
		"check": "pnpm install --frozen-lockfile && pnpm run test:rpc && pnpm run typecheck && pnpm run lint && pnpm run knip && pnpm run jscpd && pnpm run build"
	},
	"dependencies": {
		"@ai-sdk/react": "^4.0.143",
		"@cloudflare/ai-chat": "^0.12.1",
		"@cloudflare/kumo": "^2.14.0",
		"@fontsource-variable/nunito-sans": "^5.3.0",
		"@fontsource-variable/outfit": "^5.3.0",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-query": "^5.104.2",
		"@tiptap/extension-color": "3.32.0",
		"@tiptap/extension-highlight": "3.32.0",
		"@tiptap/extension-image": "3.32.0",
		"@tiptap/extension-link": "3.32.0",
		"@tiptap/extension-text-align": "3.32.0",
		"@tiptap/extension-text-style": "3.32.0",
		"@tiptap/extension-underline": "3.32.0",
		"@tiptap/react": "3.32.0",
		"@tiptap/starter-kit": "3.32.0",
		"@zp-shared/rpc": "https://cdn.zenithpayments.support/zp-shared/rpc-0.6.3.tgz",
		"agents": "^0.28.1",
		"ai": "^7.0.140",
		"dompurify": "^3.4.17",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13",
		"isbot": "^5.2.2",
		"jose": "^6.2.12",
		"postal-mime": "^4.0.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-markdown": "^10.1.0",
		"react-router": "^8.4.0",
		"remark-gfm": "^4.0.1",
		"workers-ai-provider": "^4.0.0",
		"zod": "catalog:",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.64.0",
		"@cloudflare/workers-types": "^5.20261014.1",
		"@eslint/js": "^10.0.1",
		"@react-router/dev": "^8.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"jscpd": "^5.4.1",
		"knip": "^6.41.0",
		"lefthook": "^2.2.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"wrangler": "^4.151.0"
	}
}
